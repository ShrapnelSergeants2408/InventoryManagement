{
  "name": "hiebert-home-inventory",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
