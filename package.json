    "preact": "^11.0.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/papaparse": "^5.5.2",
    "cf": "^1.0.0-beta.27",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
